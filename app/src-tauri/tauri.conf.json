{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadEase",
  "version": "0.1.16",
  "identifier": "vn.dolenglish.vieneureader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadEase — Thư Âm",
        "width": 1060,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 29
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engine"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB document",
        "contentTypes": [
          "org.idpf.epub-container"
        ],
        "mimeType": "application/epub+zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "category": "Education",
    "copyright": "© 2026 Khoa Le. PolyForm Noncommercial 1.0.0.",
    "shortDescription": "Đọc EPUB và PDF thành tiếng — tiếng Việt và tiếng Anh, giọng chạy trên máy.",
    "longDescription": "ReadEase — Thư Âm reads your EPUB and PDF files aloud in Vietnamese and English with voices that run on your Mac. Highlights follow the voice; notes, contents and search sit in a side column; documents open from Finder and the Dock."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wblekhoa/readease/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMUFBN0ZGQzhCRDJBMjgKUldRb0tyM0kvNmNhYjZBZjNiMlNpbmxsTUJOSVk0dFRLaXNlTitGNGpsNFYweXo1dDl1UjN2TkIK"
    }
  }
}
